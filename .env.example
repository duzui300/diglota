# Copy to .env in this project (it is gitignored), or set them in your environment.
# Everything here is optional: with no keys at all the reader, the vocabulary
# measurement and spaced repetition still work.

# --- Graded exercises -------------------------------------------------------
# TypeSafe System One. Returns a judgment with a confidence, which is what
# translation grading needs. Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=apikey_...
TYPESAFE_MODEL=jev-latest

# --- Tutor ------------------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint. Used for word glosses,
# comprehension questions, translation drills, and weaving imported articles.
LLM_BASE_URL=https://api.example.com/provider/v1
LLM_API_KEY=...
LLM_MODEL=deepseek/deepseek-v4.1-flash

# --- Options ----------------------------------------------------------------
# Where the hand-made diglot corpus lives.
# DIGLOT_CORPUS=/path/to/your/own/diglot/articles

# Where the database and imported articles go. Defaults to ./data.
# DIGLOT_DATA=./data

# Proxy for outbound web access (import and discovery). On this machine direct
# connections time out, so the local proxy is the default. Set to empty to
# connect directly.
DIGLOT_PROXY=http://127.0.0.1:7890
